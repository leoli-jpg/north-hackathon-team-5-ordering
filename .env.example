# OpenAI-compatible LLM configuration for NexAU and CI smoke tests.
# Do not commit real secret values.

# NexAU / OpenAI SDK runtime config
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CI smoke test config. The smoke script normalizes base_url by appending /v1
# when an OpenAI-compatible gateway root URL is provided.
LLM_API_KEY=
LLM_BASE_URL=https://northgate.xiaobei.top
LLM_MODEL=nex-agi/Nex-N2-Pro
LLM_API_TYPE=openai
RUN_LLM_SMOKE=false
